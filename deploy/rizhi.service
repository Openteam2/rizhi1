[Unit]
Description=RiZhi local-first learning journal
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=rizhi
Group=rizhi
WorkingDirectory=/opt/rizhi
Environment=NODE_ENV=production
EnvironmentFile=-/opt/rizhi/.env
ExecStart=/usr/bin/node /opt/rizhi/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rizhi/data

[Install]
WantedBy=multi-user.target
