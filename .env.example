# Server binding. Use 127.0.0.1 behind Nginx.
HOST=127.0.0.1
PORT=4173
NODE_ENV=production

# Optional AI settings. Prefer configuring the key in the app UI.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# Optional. Public GitHub API works anonymously, but a token raises rate limits.
GITHUB_TOKEN=

# Optional overrides for forks or private mirrors.
GITHUB_REPOSITORY=Openteam2/rizhi1
GITHUB_DEFAULT_BRANCH=main
GITHUB_API_BASE=https://api.github.com

# Optional. Used only to compare a local build commit with the latest commit.
APP_COMMIT_SHA=
